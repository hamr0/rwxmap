# local session context and tool state stay local — scoped, so a future
# .github/ (CI) or other deliverable dot-directory is not silently ignored
.claude/
.litectx/
docs/.docs-builder/

# secrets never enter the tree; only a value-less .env.example may be tracked
.env
*.env
!.env.example

# raw APIs.guru specs are large and re-fetchable (fetch-corpus.mjs is
# resumable); the extracted CSVs (apis-guru-ops.csv.gz, labelled.csv) stay
# tracked. apis-guru-ops.csv is the raw, unzipped form (38MB) — ignored so a
# local unzip doesn't get committed; the .csv.gz (4.5MB) is the tracked artefact.
data/corpus/apis-guru-specs/
data/corpus/apis-guru-ops.csv

# the provider corpus's original specs are tracked gzipped in place
# (42MB raw / 3.6MB gzipped, cheap enough to keep) — only ops.csv, the raw
# unzipped extract, is ignored; ops.csv.gz is the tracked artefact.
data/provider-corpus-2026-09-16/ops.csv

# devDependency (yaml) installs into node_modules; never tracked
node_modules/

# generated from JSDoc by tsc (build:types / prepack); never committed —
# no stored artefact, no drift (LIBRARY_CONVENTIONS.md §2)
/types/
