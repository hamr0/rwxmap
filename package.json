{
  "name": "rwxmap",
  "version": "0.5.0",
  "description": "Maps OpenAPI operations to r/w/x with an evidence-vs-floor flag, from HTTP-method semantics (RFC 9110) plus the verb in the path.",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./load": {
      "types": "./types/load.d.ts",
      "default": "./src/load.js"
    },
    "./discover": {
      "types": "./types/discover.d.ts",
      "default": "./src/discover.js"
    }
  },
  "scripts": {
    "test": "node --test src/*.test.js poc/step1/*.test.mjs poc/step2/*.test.mjs poc/step3/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "prepack": "npm run build:types",
    "check:lockfile": "node scripts/check-lockfile.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "hamr0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamr0/rwxmap.git"
  },
  "homepage": "https://github.com/hamr0/rwxmap#readme",
  "bugs": {
    "url": "https://github.com/hamr0/rwxmap/issues"
  },
  "keywords": [
    "actionclass",
    "agent",
    "api-classification",
    "governance",
    "mcp",
    "nodejs",
    "openapi",
    "rfc-9110",
    "safety",
    "tool-annotations",
    "zero-deps"
  ],
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "src",
    "!src/**/*.test.js",
    "types"
  ],
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}
